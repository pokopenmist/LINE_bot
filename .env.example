# LINE Messaging API
# LINE Developers Console (https://developers.line.biz/) でチャンネルを作成し、
# チャンネルアクセストークン（長期）を発行してください。
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# 送信先ID（省略時は全フォロワーへ Broadcast）
# ユーザーID: Uxxxxxxxx...
# グループID: Cxxxxxxxx...
# トークルームID: Rxxxxxxxx...
LINE_TARGET_ID=

# ニュース取得範囲（時間）
NEWS_HOURS=24

# 最大配信件数
MAX_NEWS_ITEMS=10
