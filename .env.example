# LINE Messaging API (Push Message)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# Delivery target (user ID, group ID, or room ID)
LINE_TARGET_ID=your_user_or_group_id_here

# LINE Notify (alternative simpler method)
LINE_NOTIFY_TOKEN=your_line_notify_token_here

# Delivery method: "messaging_api" or "notify"
LINE_DELIVERY_METHOD=notify

# News fetch interval in hours (default: 24)
NEWS_HOURS=24

# Maximum number of news items to deliver per run (default: 10)
MAX_NEWS_ITEMS=10
